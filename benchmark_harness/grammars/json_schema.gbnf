grammar json_schema;

start = object;

object = "{" ws (member (ws "," ws member)*)? ws "}";

member = string_literal ws ":" ws value;

value = string_literal / number / boolean / null / array / object;

array = "[" ws (value (ws "," ws value)*)? ws "]";

string_literal = '"' ([^"\\] / "\\" ["\\/bfnrt] / "\\" "u" [0-9a-fA-F]{4})* '"';

number = "-"? ([0-9]+ ("." [0-9]+)? / "." [0-9]+) ([eE] [-+]? [0-9]+)?;

boolean = "true" / "false";

null = "null";

ws = [ \t\n\r]*;