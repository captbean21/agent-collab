grammar tool_call;

start = call+;

call = "{" ws tool_name ws ":" ws args ws "}";

tool_name = string_literal;

args = "{" ws (kv_pair (ws "," ws kv_pair)*)? ws "}";

kv_pair = key ws ":" ws value;

key = string_literal;

value = string_literal / number / boolean / null / array / object;

string_literal = '"' ([^"\\] / "\\" ["\\/bfnrt] / "\\" "u" [0-9a-fA-F]{4})* '"';

number = "-"? ([0-9]+ ("." [0-9]+)? / "." [0-9]+) ([eE] [-+]? [0-9]+)?;

boolean = "true" / "false";

null = "null";

array = "[" ws (value (ws "," ws value)*)? ws "]";

object = "{" ws (kv_pair (ws "," ws kv_pair)*)? ws "}";

ws = [ \t\n\r]*;