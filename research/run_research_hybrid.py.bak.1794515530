#!/usr/bin/env python3
"""
Hybrid Research Cycle Runner — fast triage via abstracts, selective deep fetch.
State file tracks fetch depth per source for full restore path.
"""
import json
import subprocess
import sys
import time
import re
from datetime import datetime
from pathlib import Path
from urllib.parse import urlparse

RESEARCH_DIR = Path("/home/rook/.openclaw/workspace/research")
TOPICS_FILE = RESEARCH_DIR / "topics.txt"
STATE_FILE = RESEARCH_DIR / ".research_state.json"
WEB_FETCH = "/home/rook/.openclaw/workspace/tools/web_fetch.py"
SEARXNG_URL = "http://192.168.1.201:8888/search"

# Fetch depth constants
DEPTH_ABSTRACT = "abstract"
DEPTH_FULL = "full"
DEPTH_PDF = "pdf"
DEPTH_FAILED = "failed"

def load_topics():
    topics = []
    with open(TOPICS_FILE) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in line.split("|")]
            if len(parts) >= 2:
                topics.append({"slug": parts[0], "priority": int(parts[1]), "notes": parts[2] if len(parts) > 2 else ""})
    return topics

def load_state():
    if STATE_FILE.exists():
        with open(STATE_FILE) as f:
            return json.load(f)
    return {"last_researched": {}, "source_fetch_depth": {}}

def save_state(state):
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)

def searxng_search(query, num_results=5):
    import urllib.parse
    import urllib.request
    params = {"q": query, "format": "json", "safesearch": "0", "language": "en"}
    url = f"{SEARXNG_URL}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode())
        return [r["url"] for r in data.get("results", [])[:num_results]]
    except Exception as e:
        print(f"  SearXNG search failed: {e}", file=sys.stderr)
        return []

def is_arxiv_url(url):
    return "arxiv.org" in urlparse(url).netloc

def arxiv_id_from_url(url):
    """Extract arXiv ID from various URL formats."""
    patterns = [
        r'arxiv\.org/abs/(\d+\.\d+v?\d*)',
        r'arxiv\.org/html/(\d+\.\d+v?\d*)',
        r'arxiv\.org/pdf/(\d+\.\d+v?\d*)',
    ]
    for pat in patterns:
        m = re.search(pat, url)
        if m:
            return m.group(1)
    return None

def fetch_arxiv_abstract(arxiv_id):
    """Fetch structured metadata + abstract via arXiv API."""
    import urllib.request
    import xml.etree.ElementTree as ET
    api_url = f"https://export.arxiv.org/api/query?id_list={arxiv_id}"
    try:
        with urllib.request.urlopen(api_url, timeout=15) as resp:
            xml = resp.read()
        root = ET.fromstring(xml)
        ns = {"atom": "http://www.w3.org/2005/Atom", "arxiv": "http://arxiv.org/schemas/atom"}
        entry = root.find("atom:entry", ns)
        if entry is None:
            return None
        title = entry.find("atom:title", ns).text.strip()
        summary = entry.find("atom:summary", ns).text.strip()
        authors = [a.find("atom:name", ns).text for a in entry.findall("atom:author", ns)]
        published = entry.find("atom:published", ns).text
        categories = [c.get("term") for c in entry.findall("atom:category", ns)]
        return {
            "title": title,
            "abstract": summary,
            "authors": authors,
            "published": published,
            "categories": categories,
            "arxiv_id": arxiv_id,
            "url": f"https://arxiv.org/abs/{arxiv_id}"
        }
    except Exception as e:
        print(f"    arXiv API error: {e}", file=sys.stderr)
        return None

def fetch_url_generic(url, focus):
    """Fetch any URL using web_fetch.py."""
    try:
        result = subprocess.run(
            [sys.executable, WEB_FETCH, url, "--focus", focus, "--max-chars", "8000"],
            capture_output=True, text=True, timeout=60
        )
        if result.returncode == 0:
            return result.stdout.strip()
        else:
            return None
    except subprocess.TimeoutExpired:
        return None
    except Exception:
        return None

def is_highly_relevant(metadata, topic_focus):
    """Heuristic: abstract mentions keywords from topic focus."""
    if not metadata:
        return False
    focus_keywords = [w.lower() for w in topic_focus.split() if len(w) > 3]
    text = f"{metadata.get('title', '')} {metadata.get('abstract', '')}".lower()
    matches = sum(1 for kw in focus_keywords if kw in text)
    return matches >= 2  # at least 2 focus keywords in title+abstract

def format_abstract_entry(metadata):
    """Format arXiv abstract as clean markdown."""
    if not metadata:
        return ""
    lines = [
        f"### {metadata['title']}",
        f"**arXiv:** [{metadata['arxiv_id']}]({metadata['url']})  ",
        f"**Authors:** {', '.join(metadata['authors'])}  ",
        f"**Published:** {metadata['published'][:10]}  ",
        f"**Categories:** {', '.join(metadata['categories'])}  ",
        "",
        f"**Abstract:**",
        metadata['abstract'],
    ]
    return "\n".join(lines)

def append_findings(topic_slug, topic_notes, findings, fetch_log):
    """Append research findings to topic markdown file."""
    topic_file = RESEARCH_DIR / f"{topic_slug}.md"
    timestamp = datetime.utcnow().strftime("%Y-%m-%d %H:%M UTC")
    
    content = f"\n## Research Cycle — {timestamp}\n\n"
    content += f"**Topic:** {topic_slug}  \n"
    content += f"**Focus:** {topic_notes}\n\n"
    
    for entry in findings:
        content += entry + "\n\n---\n\n"
    
    with open(topic_file, "a") as f:
        f.write(content)
    
    # Update fetch log in state
    for log_entry in fetch_log:
        log_entry["topic"] = topic_slug
        log_entry["timestamp"] = timestamp
    
    print(f"  ✓ Appended to {topic_file.name} ({len(findings)} sources)")

def run_topic(topic):
    slug = topic["slug"]
    notes = topic["notes"]
    print(f"\n=== Researching: {slug} (priority {topic['priority']}) ===")
    print(f"  Focus: {notes}")
    
    query = f'{slug.replace("-", " ")} arxiv'
    print(f"  Searching SearXNG...")
    
    urls = searxng_search(query, num_results=3)
    if not urls:
        print(f"  No results found")
        return False, []
    
    print(f"  Found {len(urls)} results, triaging...")
    
    findings = []
    fetch_log = []
    
    for url in urls:
        print(f"    Processing: {url[:80]}...")
        
        if is_arxiv_url(url):
            arxiv_id = arxiv_id_from_url(url)
            if arxiv_id:
                # Phase 1: Fast abstract fetch
                print(f"      → arXiv detected, fetching abstract via API...")
                metadata = fetch_arxiv_abstract(arxiv_id)
                
                if metadata:
                    fetch_log.append({
                        "url": url,
                        "arxiv_id": arxiv_id,
                        "depth": DEPTH_ABSTRACT,
                        "status": "success"
                    })
                    
                    # Phase 2: Selective deep fetch
                    if is_highly_relevant(metadata, notes):
                        print(f"      → High relevance, fetching full HTML...")
                        full_text = fetch_url_generic(url, notes)
                        if full_text:
                            findings.append(f"### Source: {url} (FULL)\n\n{full_text}")
                            fetch_log[-1]["depth"] = DEPTH_FULL
                        else:
                            findings.append(format_abstract_entry(metadata))
                            fetch_log[-1]["depth"] = DEPTH_ABSTRACT
                            fetch_log[-1]["deep_fetch"] = "timeout"
                    else:
                        print(f"      → Low relevance, using abstract only")
                        findings.append(format_abstract_entry(metadata))
                else:
                    fetch_log.append({"url": url, "depth": DEPTH_FAILED, "status": "api_failed"})
                    print(f"      → API failed, trying generic fetch...")
                    full_text = fetch_url_generic(url, notes)
                    if full_text:
                        findings.append(f"### Source: {url} (FALLBACK FULL)\n\n{full_text}")
                        fetch_log[-1]["depth"] = DEPTH_FULL
            else:
                # Non-arXiv or unparseable, generic fetch
                full_text = fetch_url_generic(url, notes)
                if full_text:
                    findings.append(f"### Source: {url}\n\n{full_text}")
                    fetch_log.append({"url": url, "depth": DEPTH_FULL, "status": "success"})
                else:
                    fetch_log.append({"url": url, "depth": DEPTH_FAILED, "status": "fetch_failed"})
        else:
            # Non-arXiv URL, generic fetch
            full_text = fetch_url_generic(url, notes)
            if full_text:
                findings.append(f"### Source: {url}\n\n{full_text}")
                fetch_log.append({"url": url, "depth": DEPTH_FULL, "status": "success"})
            else:
                fetch_log.append({"url": url, "depth": DEPTH_FAILED, "status": "fetch_failed"})
        
        time.sleep(1)
    
    if findings:
        append_findings(slug, notes, findings, fetch_log)
        return True, fetch_log
    else:
        print(f"  No content extracted")
        return False, fetch_log

def main():
    topics = load_topics()
    state = load_state()
    
    # Ensure state structure
    if "source_fetch_depth" not in state:
        state["source_fetch_depth"] = {}
    
    priority5 = [t for t in topics if t["priority"] >= 5]
    priority5.sort(key=lambda t: state["last_researched"].get(t["slug"], ""))
    
    print(f"Priority-5 topics (by last researched):")
    for t in priority5:
        last = state["last_researched"].get(t["slug"], "never")
        print(f"  {t['slug']}: last={last}")
    
    count = 0
    all_fetch_logs = []
    for topic in priority5[:3]:
        success, fetch_log = run_topic(topic)
        all_fetch_logs.extend(fetch_log)
        if success:
            state["last_researched"][topic["slug"]] = datetime.utcnow().isoformat() + "Z"
            count += 1
        time.sleep(2)
    
    # Save fetch depth log for restore path
    state["source_fetch_depth"][datetime.utcnow().isoformat() + "Z"] = all_fetch_logs
    save_state(state)
    
    print(f"\n=== Completed {count}/3 topics ===")
    print(f"State updated: {STATE_FILE}")

if __name__ == "__main__":
    main()