# Tool Call Wrapper Grammar
# Covers: dispatch_action tool calls with id and args

root ::= tool_call

tool_call ::= "dispatch_action " "{" ws tool_fields ws "}"

tool_fields ::= tool_field (ws "," ws tool_field)*

tool_field ::= "id" ws ":" ws string_literal
            | "args" ws ":" ws args_object

args_object ::= "{" ws arg_pair (ws "," ws arg_pair)* ws "}"
arg_pair ::= string_literal ws ":" ws arg_value

arg_value ::= string_literal | number | boolean | array_literal | object_literal

array_literal ::= "[" ws array_element (ws "," ws array_element)* ws "]"
array_element ::= string_literal | number | boolean | object_literal

object_literal ::= "{" ws arg_pair (ws "," ws arg_pair)* ws "}"

string_literal ::= ~"\"[^\"]*\""
number ::= ~"[0-9]+"
boolean ::= "true" | "false"

ws ::= " " | "\t" | "\n"