# Peer Search Tool Grammar
# Covers: peer_search tool for survival backend queries

root ::= peer_search_call

peer_search_call ::= "peer_search " "{" ws peer_search_fields ws "}"

peer_search_fields ::= peer_search_field (ws "," ws peer_search_field)*

peer_search_field ::= "query" ws ":" ws string_literal
                    | "limit" ws ":" ws number
                    | "offset" ws ":" ws number
                    | "filters" ws ":" ws filters_object

filters_object ::= "{" ws filter_pair (ws "," ws filter_pair)* ws "}"
filter_pair ::= string_literal ws ":" ws filter_value

filter_value ::= string_literal | number | boolean | array_literal

array_literal ::= "[" ws array_element (ws "," ws array_element)* ws "]"
array_element ::= string_literal | number | boolean

string_literal ::= ~"\"[^\"]*\""
number ::= ~"[0-9]+"
boolean ::= "true" | "false"

ws ::= " " | "\t" | "\n"